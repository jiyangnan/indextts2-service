# IndexTTS2 微服务环境变量配置
# 复制此文件为 .env 并根据需要修改

# ============ 模型配置 ============
# 模型文件目录
MODEL_DIR=./checkpoints
CONFIG_PATH=./checkpoints/config.yaml

# 推理配置
USE_FP16=true              # 使用 FP16 推理（降低显存）
USE_CUDA_KERNEL=false       # 使用 CUDA 内核（兼容性优先）
USE_DEEPSPEED=false         # 使用 DeepSpeed 加速

# ============ 存储配置 ============
# Supabase Storage 配置（RunPod 部署）
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=magictale

# AWS S3 配置（推荐用于生产环境）
S3_ENDPOINT=
S3_BUCKET=indextts2-audio
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 阿里云 OSS 配置
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_SECRET_ACCESS_KEY=

# 本地存储配置（开发环境）
LOCAL_STORAGE_DIR=./data/audio
LOCAL_BASE_URL=http://localhost:8001

# ============ 应用配置 ============
# API 配置
# 端口 8001 避免与 MagicTale 后端（8000）冲突
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=info

# CORS 配置（生产环境需限制）
CORS_ORIGINS=*

# ============ 缓存配置（可选）============
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=604800  # 7 天（秒）

# ============ RunPod 配置（自动启停）===========
RUNPOD_API_KEY=
RUNPOD_TEMPLATE_ID=
AUTO_SCALE_ENABLED=true
IDLE_TIMEOUT_MINUTES=10
